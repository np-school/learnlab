rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ไฟล์ชั่วคราวก่อนถูก Cloud Function ย้ายขึ้น Google Drive แล้วลบทิ้ง
    // path: pending-uploads/{jobId}/{fileName}
    match /pending-uploads/{jobId}/{fileName} {
      allow read: if false; // ฝั่ง client อ่านไม่ได้เลย มีแค่ Cloud Function (admin SDK) เข้าถึง
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024; // จำกัด 50MB/ไฟล์ ปรับได้ตามต้องการ
      allow delete: if false; // ให้ Cloud Function ลบเท่านั้น
    }
    // ปกหลักสูตร (รูปภาพ) — path: course-covers/{courseId}/{fileName}
    // อัปโหลดตรงขึ้น Firebase Storage (ไม่ผ่าน Google Drive) เพราะต้องใช้ URL แสดงรูป <img> ได้ทันที
    match /course-covers/{courseId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024 // จำกัด 5MB/รูป
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
