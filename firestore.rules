rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myRoles() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    function hasRole(role) {
      return isSignedIn() && role in myRoles();
    }
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == "nattapol@nongki.ac.th";
    }
    function isStaff() {
      return hasRole('staff') || isSuperAdmin();
    }

    // users/{uid} — โปรไฟล์ผู้ใช้ + สิทธิ์
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      // เจ้าของแก้ข้อมูลตัวเองได้ แต่แก้ field roles ไม่ได้ / เจ้าหน้าที่แก้ roles ของคนอื่นได้
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && request.resource.data.roles == resource.data.roles) ||
        isStaff()
      );
    }

    // courses/{id}
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if hasRole('instructor') || isStaff();
      allow update, delete: if isStaff() || (hasRole('instructor') && resource.data.ownerUid == request.auth.uid);

      // courses/{id}/lessons/{lessonId} — เนื้อหาข้อความ/เอกสารภายในหลักสูตร
      // (ไฟล์จริงเก็บบน Google Drive แยกต่างหาก ที่นี่เก็บแค่ metadata/ลำดับ)
      function isCourseOwner() {
        return hasRole('instructor') &&
          get(/databases/$(database)/documents/courses/$(courseId)).data.ownerUid == request.auth.uid;
      }
      match /lessons/{lessonId} {
        allow read: if isSignedIn();
        allow write: if isStaff() || isCourseOwner();
      }
    }

    // uploadJobs/{jobId} — สถานะงานอัปโหลดไฟล์ขึ้น Google Drive (เขียนโดย Cloud Function เท่านั้น)
    // client แค่ "อ่าน" เพื่อ listen ผลลัพธ์แบบ realtime ตอนอัปโหลด
    match /uploadJobs/{jobId} {
      allow read: if isSignedIn();
      allow write: if false; // Cloud Function ใช้ admin SDK เขียน ไม่ผ่าน rules นี้
    }

    // enrollments/{uid_courseId}
    match /enrollments/{enrollId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow delete: if isStaff();
    }
  }
}
