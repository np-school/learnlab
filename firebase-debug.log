[debug] [2026-09-08T07:17:02.819Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/np-learnlab/rulesets {"name":"projects/np-learnlab/rulesets/2653b007-bbe5-443c-8875-b741c65792ad","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n    function myRoles() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;\n    }\n    function hasRole(role) {\n      return isSignedIn() && role in myRoles();\n    }\n    function isSuperAdmin() {\n      return isSignedIn() && request.auth.token.email == \"nattapol@nongki.ac.th\";\n    }\n    function isStaff() {\n      return hasRole('staff') || isSuperAdmin();\n    }\n\n    // users/{uid} — โปรไฟล์ผู้ใช้ + สิทธิ์\n    match /users/{uid} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn() && request.auth.uid == uid;\n      // เจ้าของแก้ข้อมูลตัวเองได้ แต่แก้ field roles ไม่ได้ / เจ้าหน้าที่แก้ roles ของคนอื่นได้\n      allow update: if isSignedIn() && (\n        (request.auth.uid == uid && request.resource.data.roles == resource.data.roles) ||\n        isStaff()\n      );\n    }\n\n    // courses/{id}\n    match /courses/{courseId} {\n      allow read: if isSignedIn();\n      allow create: if hasRole('instructor') || isStaff();\n      allow update, delete: if isStaff() || (hasRole('instructor') && resource.data.ownerUid == request.auth.uid);\n\n      // courses/{id}/lessons/{lessonId} — เนื้อหาข้อความ/เอกสารภายในหลักสูตร\n      // (ไฟล์จริงเก็บบน Google Drive แยกต่างหาก ที่นี่เก็บแค่ metadata/ลำดับ)\n      function isCourseOwner() {\n        return hasRole('instructor') &&\n          get(/databases/$(database)/documents/courses/$(courseId)).data.ownerUid == request.auth.uid;\n      }\n      match /lessons/{lessonId} {\n        allow read: if isSignedIn();\n        allow write: if isStaff() || isCourseOwner();\n      }\n    }\n\n    // uploadJobs/{jobId} — สถานะงานอัปโหลดไฟล์ขึ้น Google Drive (เขียนโดย Cloud Function เท่านั้น)\n    // client แค่ \"อ่าน\" เพื่อ listen ผลลัพธ์แบบ realtime ตอนอัปโหลด\n    match /uploadJobs/{jobId} {\n      allow read: if isSignedIn();\n      allow write: if false; // Cloud Function ใช้ admin SDK เขียน ไม่ผ่าน rules นี้\n    }\n\n    // enrollments/{uid_courseId}\n    match /enrollments/{enrollId} {\n      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isStaff());\n      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;\n      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isStaff());\n      allow delete: if isStaff();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-08T07:17:02.622479Z","metadata":{"services":["cloud.firestore"]}}
