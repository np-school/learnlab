[debug] [2026-09-08T07:16:59.745Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/np-learnlab/rulesets {"name":"projects/np-learnlab/rulesets/edd11f9c-2cac-4884-9fbd-9aca32dd2a0b","source":{"files":[{"content":"rules_version = '2';\nservice firebase.storage {\n  match /b/{bucket}/o {\n    // ไฟล์ชั่วคราวก่อนถูก Cloud Function ย้ายขึ้น Google Drive แล้วลบทิ้ง\n    // path: pending-uploads/{jobId}/{fileName}\n    match /pending-uploads/{jobId}/{fileName} {\n      allow read: if false; // ฝั่ง client อ่านไม่ได้เลย มีแค่ Cloud Function (admin SDK) เข้าถึง\n      allow write: if request.auth != null\n                   && request.resource.size < 50 * 1024 * 1024; // จำกัด 50MB/ไฟล์ ปรับได้ตามต้องการ\n      allow delete: if false; // ให้ Cloud Function ลบเท่านั้น\n    }\n    match /{allPaths=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"storage.rules"}]},"createTime":"2026-09-08T07:16:59.559327Z","metadata":{"services":["firebase.storage"]}}
